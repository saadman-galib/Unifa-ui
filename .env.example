# UniFa API origin (no trailing slash, no /api/v1 path).
# Local: leave empty so Vite proxies /api → http://localhost:4000
# Vercel: set this as Config (not Secret). Keep the VITE_ prefix — the browser
# must see it. Then Redeploy. Do not use localhost.
# Example: https://your-unifa-api.example.com
VITE_API_URL=
